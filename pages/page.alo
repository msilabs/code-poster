<template>
<main class="work" id="work" data-view="edit">
  <nav class="tabbar" aria-label="পোস্টারের ট্যাব">
    <div class="tabs" id="tabs"></div>
    <button class="tabAdd" id="tabAdd" type="button" aria-label="নতুন পোস্টার">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    </button>
    <span class="tabCount" id="tabCount"></span>
  </nav>

  <div class="viewbar">
    <div class="seg" id="viewSeg" role="radiogroup" aria-label="দেখার ধরন">
      <button type="button" role="radio" data-v="edit">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        সম্পাদনা
      </button>
      <button type="button" role="radio" data-v="preview">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
        প্রিভিউ
      </button>
    </div>
  </div>

  <aside class="panel">
    <div class="ptabs" role="tablist" aria-label="সেটিং">
      <button type="button" role="tab" id="tabWrite" aria-controls="paneWrite">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        লেখা
      </button>
      <button type="button" role="tab" id="tabDesign" aria-controls="paneDesign">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.4A5.6 5.6 0 0 0 22 9.9C22 5.5 17.5 2 12 2Z"/></svg>
        ডিজাইন
      </button>
    </div>

    <div class="notice" id="archNote" hidden>
      <p>আগের আরও <b id="archCount"></b>টা পোস্টার ট্যাবে আঁটেনি। সেগুলো এই ব্রাউজারে আলাদা করে রাখা আছে।</p>
      <div class="noticeActions">
        <button class="chip" id="archDl" type="button">JSON ডাউনলোড</button>
        <button class="chip" id="archHide" type="button">লুকান</button>
      </div>
    </div>

    <section class="pane" id="paneWrite" role="tabpanel" aria-labelledby="tabWrite">
      <div class="field">
        <label for="fTag">ট্যাগ <span class="hint">· ঐচ্ছিক</span></label>
        <input type="text" id="fTag" placeholder="যেমন JavaScript টিপস">
      </div>
      <div class="field">
        <label for="fTitle">শিরোনাম</label>
        <input type="text" id="fTitle" placeholder="যেমন map() নতুন অ্যারে বানায়">
      </div>
      <div class="field">
        <label for="fBody">ব্যাখ্যা <span class="hint">· <code class="k">`কোড`</code> আর <code class="k">**বোল্ড**</code> চলবে</span></label>
        <textarea id="fBody" rows="3" placeholder="দু-এক লাইনে বুঝিয়ে লিখুন"></textarea>
      </div>
      <div class="field">
        <label for="fFile">ফাইলের নাম <span class="hint">· কোডের জানালার মাথায়, ঐচ্ছিক</span></label>
        <input type="text" id="fFile" placeholder="যেমন app.js">
      </div>
      <div class="field">
        <div class="labelRow">
          <label for="fCode">কোড <span class="hint">· খালি রাখলে শুধু লেখার পোস্টার</span></label>
          <button class="chip" id="btnPaste" type="button">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            পেস্ট
          </button>
        </div>
        <textarea id="fCode" class="code" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="// এখানে কোড পেস্ট করুন"></textarea>
        <p class="codeMeta" id="codeMeta" aria-live="polite"><span class="cnt" id="codeCount"></span><span id="codeMsg"></span></p>
      </div>
      <div class="field">
        <label for="fLang">কোডের ভাষা <span class="hint">· রং বসাতে লাগে</span></label>
        <select id="fLang"></select>
      </div>
    </section>

    <section class="pane" id="paneDesign" role="tabpanel" aria-labelledby="tabDesign" hidden>
      <div class="group">
        <h3>লোগো ও পেজের নাম</h3>
        <div class="logoRow">
          <img class="logoPrev" id="logoPrev" alt="বর্তমান লোগো" width="56" height="56">
          <div class="logoSide">
            <div class="logoBtns">
              <button class="chip" id="logoUp" type="button">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 21h14"/></svg>
                লোগো আপলোড
              </button>
              <button class="chip" id="logoReset" type="button">msilabs লোগো</button>
            </div>
            <span class="hint">PNG, JPG বা SVG · বর্গাকার হলে ভালো দেখায়</span>
          </div>
          <input type="file" id="dLogo" accept="image/*" hidden>
        </div>
        <div class="field">
          <label for="dHandle">পেজের নাম</label>
          <input type="text" id="dHandle">
        </div>
      </div>
      <div class="group">
        <h3>থিম</h3>
        <div class="themeGrid" id="themeGrid" role="radiogroup" aria-label="থিম"></div>
      </div>
      <div class="group">
        <h3>অ্যাকসেন্ট রং</h3>
        <div class="accentRow">
          <input type="color" id="dAccent" aria-label="অ্যাকসেন্ট রং">
          <button class="chip" id="dAccentReset" type="button">থিমের রঙে ফেরত</button>
        </div>
      </div>
      <div class="group">
        <h3>ফন্ট</h3>
        <div class="row">
          <div class="field">
            <label for="dFontBn">বাংলা ফন্ট</label>
            <select id="dFontBn"></select>
          </div>
          <div class="field">
            <label for="dFontCode">কোডের ফন্ট</label>
            <select id="dFontCode"></select>
          </div>
        </div>
      </div>
      <div class="group">
        <h3>কোডের জানালা</h3>
        <div class="field">
          <label for="dCodeSize">কোডের আকার: <span id="dCodeSizeVal"></span></label>
          <input type="range" id="dCodeSize" min="0" max="40" step="1">
          <span class="hint">০ মানে নিজে থেকে মাপমতো হবে</span>
        </div>
        <div class="toggles">
          <label class="tg">লাইন নম্বর<input type="checkbox" id="tLine"></label>
          <label class="tg">জানালার বোতাম<input type="checkbox" id="tChrome"></label>
        </div>
      </div>
      <div class="group">
        <h3>নিচের লেখা</h3>
        <div class="field">
          <label class="sr" for="dFooter">নিচের লেখা</label>
          <input type="text" id="dFooter">
        </div>
      </div>
    </section>
  </aside>

  <section class="stage" id="stage" aria-label="প্রিভিউ">
    <div class="stagebar">
      <div class="seg" id="sizes" role="radiogroup" aria-label="ছবির মাপ"></div>
      <div class="dock">
        <button class="btn" id="btnCopy" type="button">
          <svg class="i-main" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="i-ok" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="bt">কপি</span>
        </button>
        <button class="btn primary" id="btnSave" type="button">
          <svg class="i-main" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          <svg class="i-ok" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="bt">ছবি সেভ করুন</span>
          <kbd id="kbd"></kbd>
        </button>
      </div>
    </div>
    <div class="canvasWrap"><canvas id="poster" width="1080" height="1350" aria-label="পোস্টারের প্রিভিউ"></canvas></div>
    <div class="dots" id="themes" role="radiogroup" aria-label="থিম"></div>
  </section>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<dialog class="dlg" id="saveDlg" aria-labelledby="saveDlgTitle">
  <div class="box">
    <h3 id="saveDlgTitle">ছবি সেভ করুন</h3>
    <p class="note">এখানে সরাসরি ডাউনলোড চালু নেই। ছবিতে রাইট-ক্লিক (ফোনে লম্বা চাপ) দিয়ে সেভ করুন।</p>
    <img id="modalImg" alt="পোস্টারের ছবি">
    <form method="dialog" class="dlgActions"><button class="btn" type="submit">বন্ধ করুন</button></form>
  </div>
</dialog>

<dialog class="dlg" id="replaceDlg" aria-labelledby="replaceDlgTitle">
  <form method="dialog" class="box">
    <h3 id="replaceDlgTitle">৫টা ট্যাবই ভরা</h3>
    <p class="note">নতুন পোস্টার বানাতে একটা সরাতে হবে। ভুল করে সরালে কয়েক সেকেন্ডের মধ্যে ফিরিয়ে আনা যাবে।</p>
    <div class="pick" id="replaceList"></div>
    <div class="dlgActions">
      <button class="btn" type="submit" value="cancel">বাতিল</button>
      <button class="btn primary" type="submit" value="ok">সরিয়ে নতুন বানান</button>
    </div>
  </form>
</dialog>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" integrity="sha512-D9gUyxqja7hBtkWpPWGt9wfbfaMGVt9gnyCvYa+jojwwPHLCzUm5i8rpk7vD7wNee9bA35eYIjobYPaQuKS1MQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/dart.min.js" integrity="sha512-xLkCPLQ74YZ17mkq6WJX4VcAH+D+fbtYxEcwKEENJtuUgMdt2A8aacH2dd1ZQVQyQHCPtIAQFaXrknvFpztpbg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</template>
